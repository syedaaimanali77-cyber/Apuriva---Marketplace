{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/v1/cron/sample",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/v1/cron/data-export-sweep",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/v1/cron/account-deletion-sweep",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/v1/cron/offer-expiry-sweep",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/v1/cron/payment-sweep",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/v1/cron/refund-reconcile-sweep",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/v1/cron/no-show-response-sweep",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/v1/cron/payout-sweep",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/v1/cron/payout-reconcile-sweep",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/v1/cron/message-retention-sweep",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/v1/cron/notification-dispatch-sweep",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/v1/cron/file-maintenance-sweep",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/v1/cron/ai-usage-sweep",
      "schedule": "0 * * * *"
    }
  ]
