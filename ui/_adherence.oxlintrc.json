{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/ai/**",
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/marketplace/**",
              "components/navigation/**",
              "components/overlays/**",
              "ui_kits/admin/**",
              "ui_kits/customer/**",
              "ui_kits/provider/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Sora|Source Sans 3|IBM Plex Mono|Noto Nastaliq Urdu))/i]",
        "message": "Font not provided by the design system. Available: Sora, Source Sans 3, IBM Plex Mono, Noto Nastaliq Urdu."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActiveBookingBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|service|providerName|providerAvatar|when|action|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ActiveBookingBanner> doesn't accept that prop. Declared props: status, service, providerName, providerAvatar, when, action, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AiActivityEntry'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|detail|time|status|confirmed|key|ref|className|style|children)$/]",
        "message": "<AiActivityEntry> doesn't accept that prop. Declared props: label, detail, time, status, confirmed."
      },
      {
        "selector": "JSXOpeningElement[name.name='AiActivityEntry'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:done|failed)$/]",
        "message": "<AiActivityEntry> status must be one of 'done' | 'failed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AiAssistantPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|children|composerValue|onComposerChange|onSend|onClose|placeholder|footer|style|key|ref|className|style|children)$/]",
        "message": "<AiAssistantPanel> doesn't accept that prop. Declared props: title, subtitle, children, composerValue, onComposerChange, onSend, onClose, placeholder, footer, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AiConfirmParameter'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|key|ref|className|style|children)$/]",
        "message": "<AiConfirmParameter> doesn't accept that prop. Declared props: label, value."
