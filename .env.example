# Copy this file to .env and fill in real local values.
# Every process.env.* read anywhere in the application must have a matching entry here
# (enforced by `npm run check:env` — see scripts/check-env-parity.ts).
#
# Never commit a real secret value — only placeholders belong in this file.

# Postgres connection string used by lib/db (connection pooling + migrations).
# Matches the local Postgres instance started by `docker compose up -d` (see docker-compose.yml).
DATABASE_URL=postgresql://apuriva:apuriva@localhost:5432/apuriva

# Shared secret that Vercel Cron sends as `Authorization: Bearer <value>` when it invokes
# app/api/v1/cron/** routes. Any value works locally; use a long random value in staging/production.
CRON_SECRET=local-dev-cron-secret

# Root secret for spec 005 auth (lib/auth/secret.ts): CSRF token derivation and TOTP-secret
# at-rest encryption, each via an HMAC-derived, purpose-scoped subkey — never used directly.
# Must be at least 32 characters. Any value works locally; use a long random value in
# staging/production, and never reuse it across environments.
AUTH_SECRET=local-dev-auth-secret-change-me-please-32chars

# Spec 008 §8 risk #1: days a "Deletion Pending" account waits before the scheduled sweep
# anonymizes it. Implementation default is 14 if unset — Legal/Product must confirm the final
# policy value before production. A config change, not a code change.
DELETION_GRACE_PERIOD_DAYS=14

# Spec 013 §8 risk #3/§9: interim feature flag for AI NL-interpretation on /search/interpret,
# until spec 041's real feature-flag infrastructure exists (feature_flags is still a bare
# baseline table). Set to "false" to fall back to keyword-only search.
SEARCH_NL_INTERPRETATION_ENABLED=true

# Spec 014 §8 risk #5/§9: interim feature flag for home-feed personalization
# (home-personalization-v1), until spec 041's real feature-flag infrastructure exists. Set to
# "false" to fall back to a static curated feed for everyone.
HOME_PERSONALIZATION_ENABLED=true

# Spec 021 §3 "Payment-provider architecture": which payment adapter lib/payments/provider resolves.
# The only value this repository ships is "sandbox" — there is no Pakistan payment-provider account,
# credentials or sandbox access, and master spec §133.5 forbids inventing any. An unknown or absent
# value is a hard failure, never a silent fallback, and the sandbox adapter REFUSES to run under
# NODE_ENV=production (its AC-10), so production must be given a real adapter before it can take
# payments. An environment variable per master spec §133.6, not a feature flag (spec 041 owns those).
PAYMENT_PROVIDER=sandbox

# Spec 021 AC-9: how long a booking may sit `pending` awaiting payment before /cron/payment-sweep
# fails it and releases the provider's slot. Defaults to 30 when unset or invalid.
PAYMENT_AUTHORIZATION_WINDOW_MINUTES=30

# Framework-managed, documented here because spec 021's AC-10 reads it: lib/payments/provider
# refuses to hand back a sandbox adapter when NODE_ENV=production, so a production deployment
# without a real payment provider declines payments instead of reporting one that never happened.
# Next.js sets this itself (development/production/test) — do not override it in normal use.
NODE_ENV=development

# Spec 022 AC-7: how long a refund may sit with an unresolved provider outcome before
# /cron/refund-reconcile-sweep escalates it for manual finance review. It is NEVER auto-failed
# (which would strand the customer's money if the provider did pay) and never auto-retried (which
# could pay twice if it did). Defaults to 60 when unset or invalid.
REFUND_AMBIGUITY_ESCALATION_MINUTES=60

# Spec 023 §3 "No-show workflow" — the reporting and response windows.
#
# A no-show cannot be reported until OPENS_MINUTES after the scheduled time (nobody is "absent" the
# instant an appointment starts) and no longer than CLOSES_HOURS after it. RESPONSE_WINDOW_HOURS is
# how long the other party has to answer before /cron/no-show-response-sweep moves the report to
# `under_review` marked `no_response` — which applies NO consequence: silence is not an admission,
# and only a Trust & Safety admin ever decides a no-show.
NO_SHOW_REPORT_OPENS_MINUTES=15
NO_SHOW_REPORT_CLOSES_HOURS=72
NO_SHOW_RESPONSE_WINDOW_HOURS=48
# Spec 023 §4 "Retention and privacy" (AC-10) — how long a RESOLVED no-show report keeps its
# evidence bundle, coarse location signal and both parties' statements before
# /cron/account-deletion-sweep nulls them. The report's audit skeleton (outcome, resolving admin,
# timestamps) is retained regardless: it is the record of a financial consequence.
NO_SHOW_EVIDENCE_RETENTION_DAYS=180
# Spec 024 §3.2 — payout-rail adapter, selected like PAYMENT_PROVIDER: no silent fallback, and a
# sandbox is refused under NODE_ENV=production. `sandbox` moves no money.
PAYOUT_PROVIDER=sandbox
# Spec 024 §3.3 — platform commission in basis points, integer [0, 10000]. There is NO default in code:
# unset means no earnings line is created. `0` here is a neutral local placeholder, not a commercial rate.
PLATFORM_FEE_BPS=0
# Spec 024 §9 — payout operational knobs (defaults shown).
PAYOUT_MINIMUM_MINOR_UNITS=0
PAYOUT_BATCH_CLOSE_INTERVAL_HOURS=24
PAYOUT_AMBIGUITY_ESCALATION_MINUTES=60
PAYOUT_MAX_AUTOMATIC_ATTEMPTS=3
PAYOUT_RETRY_BACKOFF_MINUTES=30
# How long an attempt must be `processing` before its outcome may be resolved by idempotency-key lookup,
# so a transfer still in flight is never reported as not received.
PAYOUT_ATTEMPT_GRACE_MINUTES=15
PAYOUT_STALE_PENDING_HOURS=168
PAYOUT_NEGATIVE_BALANCE_ALERT_DAYS=30
STATEMENT_MAX_RANGE_DAYS=366
STATEMENT_MAX_ROWS=5000

# Spec 025 §4 "Retention and privacy" (AC-4): days an ARCHIVED booking conversation (booking settled,
# cancelled, refunded or failed) is kept before /cron/message-retention-sweep anonymizes its message
# bodies. Rows are never deleted and active conversations are never swept. Defaults to 730 when unset
# or invalid; values below 90 are raised to 90. Legal/Product must confirm the final policy value before
# production — a config change, not a code change. Server-side config, not a feature flag (spec 041).
MESSAGE_RETENTION_DAYS=730

# Spec 026 §9 "Environment" — notifications. NOTIFICATION_CHANNEL_PROVIDER selects the push/email/SMS adapter
# set exactly like PAYMENT_PROVIDER: no silent fallback for an unknown name, and a sandbox is refused under
# NODE_ENV=production. `sandbox` SENDS NOTHING — it only records attempts in memory. In-app notifications
# need no provider. /cron/notification-dispatch-sweep retries a failed security/payments/operational
# delivery up to NOTIFICATION_MAX_ATTEMPTS (exponential backoff, then push -> email -> sms fallback).
NOTIFICATION_CHANNEL_PROVIDER=sandbox
NOTIFICATION_MAX_ATTEMPTS=5
# Promotional notifications require marketing consent AND are capped per user: at most
# MARKETING_MAX_PER_WINDOW in any rolling MARKETING_WINDOW_DAYS (transactional categories never count).
MARKETING_MAX_PER_WINDOW=3
MARKETING_WINDOW_DAYS=7
# READ notifications older than this are deleted by /cron/account-deletion-sweep. Unread ones never are.
NOTIFICATION_RETENTION_DAYS=180

# Spec 027 §9 "Environment" — file uploads and media storage.
#
# FILE_STORAGE_PROVIDER and FILE_SCANNER select their adapter exactly like PAYMENT_PROVIDER: no
# silent fallback for an unknown name, and a SANDBOX IS REFUSED under NODE_ENV=production, so a
# production deployment without real adapters fails loudly (503 FILE_STORAGE_UNAVAILABLE) instead of
# pretending a file was stored, scanned or delivered. No object-storage, CDN or malware-scanning
# vendor exists in this repository and none is invented.
#
# `local` is DEVELOPMENT/TEST ONLY: plain files under FILE_STORAGE_LOCAL_DIR (default: a directory
# in the OS temp dir, so nothing lands in the repository). `sandbox` DETECTS NO MALWARE — it
# rejects the standard EICAR test string and the documented APURIVA-TEST-UNSAFE marker, returns
# `unknown` for APURIVA-TEST-UNKNOWN, and `clean` otherwise. It claims no detection capability.
FILE_STORAGE_PROVIDER=local
# Empty means the default: <os temp dir>/apuriva-file-storage.
FILE_STORAGE_LOCAL_DIR=
FILE_SCANNER=sandbox
# Unset means there is NO public URL at all: GET /files/{id} falls back to a signed URL rather than
# claiming a CDN delivery path that does not exist. A public asset's URL carries the delivery
# transform (width cap + quality) — this repository resizes nothing itself and does not pretend to.
FILE_PUBLIC_CDN_BASE_URL=
# How long an issued signed URL stays valid. It is bound to (fileAssetId, userId, expiry) and is
# NEVER an authorization of its own: every content fetch re-runs the context policy's read check.
FILE_SIGNED_URL_TTL_SECONDS=300
# How long the client has to send the bytes before the reservation is swept (bytes never written to
# a reservation older than twice this are purged by /cron/file-maintenance-sweep).
FILE_UPLOAD_URL_TTL_SECONDS=900
# Scan attempts (2^attempts-minute backoff) before an UNRESOLVED scan stops being auto-claimed and
# logs file.scan_unresolved for an operator. It never becomes `ready` on a guess at any attempt.
FILE_SCAN_MAX_ATTEMPTS=5
# Per-kind size ceilings, enforced twice: on the DECLARED size at upload-url (so no bytes are
# written) and on the ACTUAL stored object at finalize. Explicit product defaults, not requirements
# fixed by the master spec — Product retunes these without a code change.
FILE_MAX_IMAGE_BYTES=10485760
FILE_MAX_DOCUMENT_BYTES=20971520
FILE_MAX_VIDEO_BYTES=104857600
# Days a SOFT-DELETED asset's bytes are retained before /cron/file-maintenance-sweep purges them.
# The row and its linkage rows are never deleted, and a legal_hold asset is never purged.
FILE_PURGE_GRACE_DAYS=7
